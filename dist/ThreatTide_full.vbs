' ----------------------------------------------------------------------------
' tt_money.vbs
' ----------------------------------------------------------------------------
' =============================================================================
' Threat Tide - dollar formatting
'
' Dollars are always Doubles. VBScript Long overflows at $2.1B, and Mod / \
' convert to Long, so this file avoids both. Formatting is done by hand so the
' cabinet's Windows locale can't change separators.
' =============================================================================

' Round to whole dollars.
Function TTRound(v)
    TTRound = Int(CDbl(v) + 0.5)
End Function

' Whole-number digits with no grouping, e.g. 1234500 -> "1234500".
Function TTDigits(v)
    Dim n : n = TTRound(v)
    If n < 0 Then n = 0
    TTDigits = FormatNumber(n, 0, -1, 0, 0)
End Function

' Insert thousands separators into a digit string.
Function TTGroup(digits)
    Dim s, out, i, count
    s = digits
    out = ""
    count = 0
    For i = Len(s) To 1 Step -1
        If count = 3 Then
            out = "," & out
            count = 0
        End If
        out = Mid(s, i, 1) & out
        count = count + 1
    Next
    TTGroup = out
End Function

' Full figure: $1,234,500
Function TTMoneyFull(v)
    TTMoneyFull = "$" & TTGroup(TTDigits(v))
End Function

' One decimal place in units of `unitSize`, e.g. 12400000 / 1e6 -> "12.4"
Function TTOneDecimal(v, unitSize)
    Dim tenths, whole, frac
    tenths = Int(CDbl(v) / (unitSize / 10) + 0.5)
    whole = Int(tenths / 10)
    frac = tenths - whole * 10
    TTOneDecimal = TTGroup(TTDigits(whole)) & "." & CStr(frac)
End Function

' Display figure: full below $10M, then $12.4M, then $1.2B.
Function TTMoney(v)
    Dim d : d = CDbl(v)
    If d >= 1000000000 Then
        TTMoney = "$" & TTOneDecimal(d, 1000000000) & "B"
    ElseIf d >= 10000000 Then
        TTMoney = "$" & TTOneDecimal(d, 1000000) & "M"
    Else
        TTMoney = TTMoneyFull(d)
    End If
End Function

' ----------------------------------------------------------------------------
' tt_rules.vbs
' ----------------------------------------------------------------------------
' =============================================================================
' Threat Tide - game rules
'
' Pure rules: no VPX objects, so this file runs under Windows cscript for tests.
' Time is passed in as milliseconds (VPX GameTime). The rules report what
' happened by calling a global Sub TTEmit(kind, a, b), which tt_table.vbs
' (on the cabinet) or tests/test_lib.vbs (in CI) defines.
'
' Events emitted (kind, a, b):
'   "ball"           ball number, extra-ball flag   new ball ready to release
'   "card"           card index, dollars             any stage shot scored
'   "collected"      stage, dollars                  lit stage collected (not Impact)
'   "combo"          dollars, -                       LM -> IA combo paid
'   "path"           award, multiplier used           Attack Path complete
'   "extraball"      -, -
'   "edr"            Path value after cut, -
'   "asset"          assets dropped, new Impact
'   "patch"          stage un-lit, -                   Patch Tuesday
'   "ballsave_relit" -, -
'   "saved"          -, -                              drain saved: serve a ball
'   "bonus"          dollars, seconds                  dwell bonus at drain
'   "evicted"        -, -                              ball ended
'   "tilt_warning"   warning number, -
'   "tilt"           -, -
'   "gameover"       final score, -
' Phase 2 - Expert Consensus multiball and Air Gap
'   "lock_lit"       locks lit, -                      asset bank lit a lock
'   "lock"           balls locked, -                   hold this ball, serve another
'   "multiball"      balls to add, -                   3rd lock: release the lock + add balls
'   "agreement"      jackpot paid, stage               two experts agreed
'   "multiball_end"  -, -
'   "airgap"         award, -                          captive SCADA/OT ball collected
' Phase 3 - Storm Surge wizard
'   "surge_start"    multiplier, -
'   "surge_swing"    multiplier, peak                  shared weather changed
'   "surge_tail"     tail jackpot, peak multiplier     centre ramp collected
'   "surge_end"      collected (True/False), -
' =============================================================================

Class TTGame
    ' ---- Public state (read by display and report) ----
    Public IsActive          ' game running
    Public Score             ' Double, dollars
    Public BallNum
    Public BallsPerGame
    Public ExtraBalls        ' pending extra balls
    Public ExtraBallAwarded
    Public Impact            ' Double, current Impact value
    Public AssetsDropped
    Public PathMult
    Public PathsCompleted
    Public WorstPathValue
    Public Tilted
    Public TiltWarnings
    Public Launched          ' ball has left the plunger lane
    Public BallSaveUntilMs
    Public BallSaveArmed     ' relit IR retainer, used on next drain
    Public PatchTuesdayOn
    Public BallsInPlay

    ' Phase 2
    Public LocksLit          ' Impact will lock the next ball when > 0
    Public BallsLocked
    Public MultiballActive
    Public MultiballsPlayed
    Public Jackpot           ' consensus jackpot ($)
    Public AgreementCount    ' this game
    Public AirGapOpen        ' gate open
    Public AirGapBreached    ' collected at least once this game
    Public HitBallId         ' set by the glue before each StageHit (ActiveBall.ID)

    ' Phase 3
    Public SurgeActive
    Public SurgePlayed
    Public SurgeMult
    Public SurgePeak
    Public SurgeSum          ' dollars scored during the mode
    Public SurgeEndMs
    Public SurgeTail         ' tail jackpot collected this game

    ' ---- Test hooks: force the next random pick (-1 = random) ----
    Public CardOverride
    Public PatchOverride
    Public SurgeOverride

    ' ---- Private state ----
    Private m_done()
    Private m_value()
    Private m_card()
    Private m_worstCards()
    Private m_lastStageMs
    Private m_lastLateralMs
    Private m_lastTiltMs
    Private m_reconCount
    Private m_resaveGiven
    Private m_nextPatchMs
    Private m_mbLastStage
    Private m_mbLastMs
    Private m_mbLastBall
    Private m_nextSwingMs

    Private Sub Class_Initialize()
        ReDim m_done(TT_STAGE_COUNT - 1)
        ReDim m_value(TT_STAGE_COUNT - 1)
        ReDim m_card(TT_STAGE_COUNT - 1)
        ReDim m_worstCards(TT_STAGE_COUNT - 1)
        IsActive = False
        Score = 0
        BallNum = 0
        ExtraBalls = 0
        ExtraBallAwarded = False
        Impact = CDbl(TT_IMPACT_START)
        AssetsDropped = 0
        PathMult = TT_PATH_MULT_START
        PathsCompleted = 0
        Tilted = False
        TiltWarnings = 0
        Launched = False
        BallSaveUntilMs = 0
        BallSaveArmed = False
        BallsInPlay = 0
        HitBallId = -1
        m_lastStageMs = 0
        m_lastLateralMs = -1
        m_lastTiltMs = -100000
        m_reconCount = 0
        m_resaveGiven = False
        m_nextPatchMs = 0
        CardOverride = -1
        PatchOverride = -1
        SurgeOverride = -1
        BallsPerGame = TT_BallsPerGame
        PatchTuesdayOn = TT_PatchTuesdayOn
        ResetGameModes
        ResetChain
        ClearWorst
    End Sub

    ' ======================== Game / ball flow ========================

    Public Sub StartGame(nowMs)
        IsActive = True
        Score = 0
        BallNum = 1
        BallsPerGame = TT_BallsPerGame
        PatchTuesdayOn = TT_PatchTuesdayOn
        ExtraBalls = 0
        ExtraBallAwarded = False
        Impact = CDbl(TT_IMPACT_START)
        AssetsDropped = 0
        PathsCompleted = 0
        ResetGameModes
        ClearWorst
        StartBall nowMs, False
    End Sub

    Private Sub ResetGameModes()
        LocksLit = 0
        BallsLocked = 0
        MultiballActive = False
        MultiballsPlayed = 0
        Jackpot = CDbl(TT_CONSENSUS_JACKPOT_START)
        AgreementCount = 0
        AirGapOpen = False
        AirGapBreached = False
        SurgeActive = False
        SurgePlayed = False
        SurgeMult = 1
        SurgePeak = 1
        SurgeSum = 0
        SurgeEndMs = 0
        SurgeTail = 0
        m_mbLastStage = -1
        m_mbLastMs = -100000
        m_mbLastBall = -1
        m_nextSwingMs = 0
    End Sub

    Private Sub StartBall(nowMs, isExtra)
        ResetChain
        PathMult = TT_PATH_MULT_START
        Tilted = False
        TiltWarnings = 0
        m_lastTiltMs = -100000
        Launched = False
        BallSaveUntilMs = 0
        BallSaveArmed = False
        BallsInPlay = 1
        m_reconCount = 0
        m_resaveGiven = False
        m_lastStageMs = nowMs
        m_lastLateralMs = -1
        m_nextPatchMs = nowMs + TT_PATCH_TUESDAY_MS
        TTEmit "ball", BallNum, isExtra
    End Sub

    ' Ball has left the plunger lane. Starts the IR retainer and the clocks once per ball.
    Public Sub BallLaunched(nowMs)
        If Not IsActive Or Launched Then Exit Sub
        Launched = True
        BallSaveUntilMs = nowMs + TT_BALLSAVE_MS
        m_lastStageMs = nowMs
        m_nextPatchMs = nowMs + TT_PATCH_TUESDAY_MS
    End Sub

    Public Function BallSaveActive(nowMs)
        BallSaveActive = (Launched And nowMs < BallSaveUntilMs) Or BallSaveArmed
    End Function

    ' Returns 0 = saved (serve a ball), 1 = next ball (or extra ball),
    ' 2 = game over, 3 = multiball ball lost, others still in play.
    Public Function Drain(nowMs)
        Dim secs, bonus
        Drain = 2
        If Not IsActive Then Exit Function

        ' Multiball: losing a ball only ends the mode when one is left.
        If BallsInPlay > 1 Then
            If Not Tilted And Launched And nowMs < BallSaveUntilMs Then
                TTEmit "saved", 0, 0
                Drain = 0
                Exit Function
            End If
            BallsInPlay = BallsInPlay - 1
            If BallsInPlay = 1 And MultiballActive Then EndMultiball
            Drain = 3
            Exit Function
        End If

        If Not Tilted Then
            If Launched And nowMs < BallSaveUntilMs Then
                BallSaveUntilMs = 0
                TTEmit "saved", 0, 0
                Drain = 0
                Exit Function
            ElseIf BallSaveArmed Then
                BallSaveArmed = False
                TTEmit "saved", 0, 0
                Drain = 0
                Exit Function
            End If
        End If

        ' Dwell time bonus (lost on tilt)
        If Tilted Then
            bonus = 0
            secs = 0
        Else
            secs = Int((nowMs - m_lastStageMs) / 1000)
            If secs < 0 Then secs = 0
            bonus = CDbl(secs) * TT_DWELL_PER_SEC
            If bonus > TT_DWELL_CAP Then bonus = CDbl(TT_DWELL_CAP)
        End If
        Score = Score + bonus
        TTEmit "bonus", bonus, secs
        TTEmit "evicted", 0, 0

        ' The Path in progress is lost; banked dollars stay.
        ResetChain
        If MultiballActive Then EndMultiball
        If SurgeActive Then EndSurge False
        BallsInPlay = 0

        If ExtraBalls > 0 Then
            ExtraBalls = ExtraBalls - 1
            StartBall nowMs, True
            Drain = 1
        ElseIf BallNum < BallsPerGame Then
            BallNum = BallNum + 1
            StartBall nowMs, False
            Drain = 1
        Else
            IsActive = False
            TTEmit "gameover", Score, 0
            Drain = 2
        End If
    End Function

    ' Call every frame. Runs Patch Tuesday and the Storm Surge clock.
    Public Sub Tick(nowMs)
        If Not IsActive Or Not Launched Then Exit Sub
        If SurgeActive Then SurgeTick nowMs
        If Tilted Or Not PatchTuesdayOn Then Exit Sub
        If nowMs < m_nextPatchMs Then Exit Sub
        m_nextPatchMs = nowMs + TT_PATCH_TUESDAY_MS
        If Not SurgeActive Then PatchOne
    End Sub

    ' ======================== Shots ========================

    Public Sub StageHit(stage, nowMs)
        Dim c, value, isLit
        If Not IsActive Or Tilted Then Exit Sub
        If stage < 0 Or stage >= TT_STAGE_COUNT Then Exit Sub

        c = DrawCard(stage)
        m_lastStageMs = nowMs
        If MultiballActive Then ConsensusHit stage, nowMs

        ' Storm Surge: every shot is lit, the chain is frozen.
        If SurgeActive Then
            value = TTRound(TT_Cards(c)(3) * Impact * SurgeMult)
            Score = Score + value
            SurgeSum = SurgeSum + value
            TTEmit "card", c, value
            Exit Sub
        End If

        isLit = (stage = NextLitStage())
        value = TT_Cards(c)(3) * Impact
        If Not isLit Then value = value * TT_UNLIT_SHARE

        If stage = ST_INITIAL_ACCESS And m_lastLateralMs >= 0 Then
            If nowMs - m_lastLateralMs <= TT_COMBO_WINDOW_MS Then
                value = value * TT_COMBO_MULT
                TTEmit "combo", TTRound(value), 0
            End If
            m_lastLateralMs = -1
        End If
        If stage = ST_LATERAL Then m_lastLateralMs = nowMs

        value = TTRound(value)
        Score = Score + value
        TTEmit "card", c, value

        If isLit Then
            m_done(stage) = True
            m_value(stage) = value
            m_card(stage) = c
            If stage = ST_IMPACT Then
                CompletePath nowMs
            Else
                TTEmit "collected", stage, value
                If stage = ST_RECON Then ReconCollected
            End If
        End If

        If stage = ST_IMPACT Then TryLock nowMs
    End Sub

    ' Slingshot: "Detected: EDR"
    Public Sub EdrHit(nowMs)
        Dim i
        If Not IsActive Or Tilted Then Exit Sub
        For i = 0 To TT_STAGE_COUNT - 1
            If m_done(i) Then m_value(i) = m_value(i) * (1 - TT_EDR_CUT)
        Next
        TTEmit "edr", PathValue(), 0
    End Sub

    ' Asset drop target. Every full bank lights a lock.
    Public Sub AssetDropped(nowMs)
        If Not IsActive Or Tilted Then Exit Sub
        AssetsDropped = AssetsDropped + 1
        Impact = Impact + TT_IMPACT_STEP
        TTEmit "asset", AssetsDropped, Impact
        If (AssetsDropped Mod TT_ASSETS_PER_LOCK) = 0 And Not MultiballActive Then
            If LocksLit + BallsLocked < TT_LOCKS_FOR_MULTIBALL Then
                LocksLit = LocksLit + 1
                TTEmit "lock_lit", LocksLit, 0
            End If
        End If
    End Sub

    ' Captive SCADA / OT ball behind the Air Gap gate.
    Public Sub AirGapHit(nowMs)
        Dim award
        If Not IsActive Or Tilted Or Not AirGapOpen Then Exit Sub
        award = TTRound(Jackpot * TT_AIRGAP_MULT)
        Score = Score + award
        AirGapOpen = False
        AirGapBreached = True
        TTEmit "airgap", award, 0
    End Sub

    ' Centre ramp: collects the Storm Surge tail jackpot.
    Public Sub CentreRampHit(nowMs)
        Dim tail
        If Not IsActive Or Tilted Or Not SurgeActive Then Exit Sub
        tail = TTRound(SurgeSum * SurgePeak)
        Score = Score + tail
        SurgeTail = SurgeTail + tail
        TTEmit "surge_tail", tail, SurgePeak
        EndSurge True
    End Sub

    ' Tilt bob / plumb hit
    Public Sub TiltBob(nowMs)
        If Not IsActive Or Tilted Then Exit Sub
        If nowMs - m_lastTiltMs < TT_TILT_DEBOUNCE_MS Then Exit Sub
        m_lastTiltMs = nowMs
        TiltWarnings = TiltWarnings + 1
        If TiltWarnings > TT_TILT_WARNINGS Then
            Tilted = True
            AirGapOpen = False
            If SurgeActive Then EndSurge False
            TTEmit "tilt", 0, 0
        Else
            TTEmit "tilt_warning", TiltWarnings, 0
        End If
    End Sub

    ' ======================== Queries ========================

    ' Lowest stage not yet collected. In-order means "this one next".
    Public Function NextLitStage()
        Dim i
        For i = 0 To TT_STAGE_COUNT - 1
            If Not m_done(i) Then
                NextLitStage = i
                Exit Function
            End If
        Next
        NextLitStage = TT_STAGE_COUNT
    End Function

    Public Function StageDone(i)
        StageDone = m_done(i)
    End Function

    Public Function StageValue(i)
        StageValue = m_value(i)
    End Function

    Public Function StageCard(i)
        StageCard = m_card(i)
    End Function

    ' Sum of collected stage values in the Path in progress.
    Public Function PathValue()
        Dim i, s
        s = 0
        For i = 0 To TT_STAGE_COUNT - 1
            If m_done(i) Then s = s + m_value(i)
        Next
        PathValue = s
    End Function

    ' Card index for each stage of the costliest Path (-1 if none).
    Public Function WorstPathCard(i)
        WorstPathCard = m_worstCards(i)
    End Function

    ' Seconds left in Storm Surge (0 if not running).
    Public Function SurgeSecondsLeft(nowMs)
        If Not SurgeActive Then
            SurgeSecondsLeft = 0
        Else
            SurgeSecondsLeft = Int((SurgeEndMs - nowMs + 999) / 1000)
            If SurgeSecondsLeft < 0 Then SurgeSecondsLeft = 0
        End If
    End Function

    ' ======================== Internals: Paths ========================

    Private Sub CompletePath(nowMs)
        Dim award, i, multUsed
        multUsed = PathMult
        award = TTRound(PathValue() * multUsed)
        Score = Score + award
        PathsCompleted = PathsCompleted + 1

        If award > WorstPathValue Then
            WorstPathValue = award
            For i = 0 To TT_STAGE_COUNT - 1
                m_worstCards(i) = m_card(i)
            Next
        End If

        TTEmit "path", award, multUsed

        PathMult = PathMult + TT_PATH_MULT_STEP
        If PathMult > TT_PATH_MULT_MAX Then PathMult = TT_PATH_MULT_MAX

        If PathsCompleted = TT_EXTRA_BALL_AT_PATH And Not ExtraBallAwarded Then
            ExtraBallAwarded = True
            ExtraBalls = ExtraBalls + 1
            TTEmit "extraball", 0, 0
        End If

        ResetChain

        If PathsCompleted >= TT_WIZARD_AT_PATHS And Not SurgePlayed Then StartSurge nowMs
    End Sub

    Private Sub ReconCollected()
        m_reconCount = m_reconCount + 1
        If m_reconCount >= TT_RECON_FOR_RESAVE And Not m_resaveGiven Then
            m_resaveGiven = True
            BallSaveArmed = True
            TTEmit "ballsave_relit", 0, 0
        End If
    End Sub

    ' Patch Tuesday: one random collected stage (never Impact) drops back to unlit.
    Private Sub PatchOne()
        Dim i, n, pick, picked
        n = 0
        For i = 0 To TT_STAGE_COUNT - 2
            If m_done(i) Then n = n + 1
        Next
        If n = 0 Then Exit Sub

        If PatchOverride >= 0 Then
            picked = PatchOverride
            PatchOverride = -1
        Else
            pick = Int(Rnd * n)
            picked = -1
            For i = 0 To TT_STAGE_COUNT - 2
                If m_done(i) Then
                    If pick = 0 Then
                        picked = i
                        Exit For
                    End If
                    pick = pick - 1
                End If
            Next
        End If
        If picked < 0 Then Exit Sub
        If Not m_done(picked) Then Exit Sub

        m_done(picked) = False
        m_value(picked) = 0
        m_card(picked) = -1
        TTEmit "patch", picked, 0
    End Sub

    ' ======================== Internals: Expert Consensus ========================

    Private Sub TryLock(nowMs)
        If LocksLit <= 0 Or MultiballActive Then Exit Sub
        LocksLit = LocksLit - 1
        BallsLocked = BallsLocked + 1
        If BallsLocked >= TT_LOCKS_FOR_MULTIBALL Then
            StartMultiball nowMs
        Else
            TTEmit "lock", BallsLocked, 0
        End If
    End Sub

    Private Sub StartMultiball(nowMs)
        Dim adding
        adding = TT_LOCKS_FOR_MULTIBALL - 1
        MultiballActive = True
        MultiballsPlayed = MultiballsPlayed + 1
        BallsLocked = 0
        LocksLit = 0
        BallsInPlay = BallsInPlay + adding
        Jackpot = CDbl(TT_CONSENSUS_JACKPOT_START)
        AirGapOpen = True
        BallSaveUntilMs = nowMs + TT_MB_BALLSAVE_MS
        m_mbLastStage = -1
        m_mbLastMs = -100000
        m_mbLastBall = -1
        TTEmit "multiball", adding, 0
    End Sub

    Private Sub EndMultiball()
        MultiballActive = False
        AirGapOpen = False
        TTEmit "multiball_end", 0, 0
    End Sub

    ' Same stage as the previous multiball hit, inside the window, by a
    ' different ball = agreement. A hit on a different stage = scattered.
    Private Sub ConsensusHit(stage, nowMs)
        If stage = m_mbLastStage And nowMs - m_mbLastMs <= TT_CONSENSUS_WINDOW_MS _
           And HitBallId <> m_mbLastBall And HitBallId >= 0 Then
            Score = Score + Jackpot
            AgreementCount = AgreementCount + 1
            TTEmit "agreement", Jackpot, stage
            Jackpot = Jackpot + TT_CONSENSUS_JACKPOT_STEP
            m_mbLastStage = -1
            m_mbLastMs = -100000
            m_mbLastBall = -1
            Exit Sub
        End If
        If m_mbLastStage >= 0 And stage <> m_mbLastStage Then
            Jackpot = TTRound(Jackpot * (1 - TT_CONSENSUS_DECAY))
            If Jackpot < TT_CONSENSUS_JACKPOT_MIN Then Jackpot = CDbl(TT_CONSENSUS_JACKPOT_MIN)
        End If
        m_mbLastStage = stage
        m_mbLastMs = nowMs
        m_mbLastBall = HitBallId
    End Sub

    ' ======================== Internals: Storm Surge ========================

    Private Sub StartSurge(nowMs)
        SurgeActive = True
        SurgePlayed = True
        SurgeSum = 0
        SurgeEndMs = nowMs + TT_SURGE_MS
        SurgeMult = NextSurgeMult()
        SurgePeak = SurgeMult
        m_nextSwingMs = nowMs + TT_SURGE_SWING_MS
        TTEmit "surge_start", SurgeMult, 0
    End Sub

    Private Sub SurgeTick(nowMs)
        If nowMs >= SurgeEndMs Then
            EndSurge False
            Exit Sub
        End If
        If nowMs >= m_nextSwingMs Then
            m_nextSwingMs = m_nextSwingMs + TT_SURGE_SWING_MS
            SurgeMult = NextSurgeMult()
            If SurgeMult > SurgePeak Then SurgePeak = SurgeMult
            TTEmit "surge_swing", SurgeMult, SurgePeak
        End If
    End Sub

    Private Sub EndSurge(collected)
        If Not SurgeActive Then Exit Sub
        SurgeActive = False
        SurgeMult = 1
        TTEmit "surge_end", collected, 0
    End Sub

    Private Function NextSurgeMult()
        If SurgeOverride >= 0 Then
            NextSurgeMult = SurgeOverride
            SurgeOverride = -1
        Else
            NextSurgeMult = TT_SURGE_MULT_MIN + Int(Rnd * (TT_SURGE_MULT_MAX - TT_SURGE_MULT_MIN + 1))
        End If
    End Function

    ' ======================== Internals: misc ========================

    Private Function DrawCard(stage)
        Dim i, n, pick
        If CardOverride >= 0 Then
            DrawCard = CardOverride
            CardOverride = -1
            Exit Function
        End If
        n = 0
        For i = 0 To UBound(TT_Cards)
            If TT_Cards(i)(0) = stage Then n = n + 1
        Next
        pick = Int(Rnd * n)
        For i = 0 To UBound(TT_Cards)
            If TT_Cards(i)(0) = stage Then
                If pick = 0 Then
                    DrawCard = i
                    Exit Function
                End If
                pick = pick - 1
            End If
        Next
        DrawCard = 0
    End Function

    Private Sub ResetChain()
        Dim i
        For i = 0 To TT_STAGE_COUNT - 1
            m_done(i) = False
            m_value(i) = 0
            m_card(i) = -1
        Next
    End Sub

    Private Sub ClearWorst()
        Dim i
        WorstPathValue = 0
        For i = 0 To TT_STAGE_COUNT - 1
            m_worstCards(i) = -1
        Next
    End Sub
End Class

' Card helpers (shared by display, report and tests)
Function TTCardName(c)
    If c < 0 Then
        TTCardName = ""
    Else
        TTCardName = TT_Cards(c)(1)
    End If
End Function

Function TTCardId(c)
    If c < 0 Then
        TTCardId = ""
    Else
        TTCardId = TT_Cards(c)(2)
    End If
End Function

Function TTCardStage(c)
    TTCardStage = TT_Cards(c)(0)
End Function

' ----------------------------------------------------------------------------
' tt_sound.vbs
' ----------------------------------------------------------------------------
' =============================================================================
' Threat Tide - sound
'
' Logical cue names map to sounds imported into the table's Sound Manager.
' Missing sounds are skipped silently so the table runs before audio is final.
' Original or royalty-free audio only: record every file in docs/LICENSES.md.
' =============================================================================

' Logical cue -> VPX sound name
Function TTSoundName(cue)
    Select Case cue
        Case "initial_access": TTSoundName = "vo_initial_access"   ' "Initial access"
        Case "path":           TTSoundName = "vo_path_complete"    ' "Path complete"
        Case "air_gap":        TTSoundName = "vo_air_gap_breached" ' "Air gap breached" (Phase 2)
        Case "storm_surge":    TTSoundName = "vo_storm_surge"      ' "Storm surge" (Phase 3)
        Case "card":           TTSoundName = "sfx_card"
        Case "unlit":          TTSoundName = "sfx_unlit"
        Case "combo":          TTSoundName = "sfx_combo"
        Case "edr":            TTSoundName = "sfx_edr"
        Case "asset":          TTSoundName = "sfx_asset"
        Case "patch":          TTSoundName = "sfx_patch"
        Case "saved":          TTSoundName = "sfx_ballsave"
        Case "drain":          TTSoundName = "sfx_drain"
        Case "extraball":      TTSoundName = "vo_extra_ball"
        Case "lock_lit":       TTSoundName = "sfx_lock_lit"
        Case "lock":           TTSoundName = "vo_expert_locked"     ' "Expert locked"
        Case "multiball":      TTSoundName = "vo_expert_consensus"  ' "Expert consensus"
        Case "jackpot":        TTSoundName = "vo_jackpot"
        Case "tilt_warning":   TTSoundName = "sfx_tilt_warning"
        Case "tilt":           TTSoundName = "vo_incident_declared"
        Case "gameover":       TTSoundName = "sfx_gameover"
        Case "flipper":        TTSoundName = "sfx_flipper"
        Case "sling":          TTSoundName = "sfx_sling"
        Case "kicker":         TTSoundName = "sfx_kicker"
        Case "droptarget":     TTSoundName = "sfx_droptarget"
        Case "release":        TTSoundName = "sfx_ballrelease"
        Case Else:             TTSoundName = ""
    End Select
End Function

' Volumes per preset. Halls are loud, so "booth" pushes callouts up.
Function TTVolume(kind)
    If TT_VolumePreset = "quiet" Then
        Select Case kind
            Case "voice": TTVolume = 0.5
            Case "music": TTVolume = 0.15
            Case Else:    TTVolume = 0.35
        End Select
    Else
        Select Case kind
            Case "voice": TTVolume = 1.0
            Case "music": TTVolume = 0.35
            Case Else:    TTVolume = 0.7
        End Select
    End If
End Function

Sub TTPlay(cue)
    Dim n, vol
    n = TTSoundName(cue)
    If n = "" Then Exit Sub
    If Left(n, 3) = "vo_" Then
        vol = TTVolume("voice")
    Else
        vol = TTVolume("sfx")
    End If
    On Error Resume Next
    PlaySound n, 0, vol
    On Error GoTo 0
End Sub

' Music files live in VPX's Music folder under ThreatTide\
' The current track loops: VPX calls Table1_MusicDone when it ends.
Dim TTMusicTrack : TTMusicTrack = ""

Sub TTMusic(track)
    If track = TTMusicTrack And track <> "" Then Exit Sub   ' already playing
    TTMusicTrack = track
    On Error Resume Next
    EndMusic
    If track <> "" Then PlayMusic "ThreatTide\" & track, TTVolume("music")
    On Error GoTo 0
End Sub

Sub TTMusicLoop()
    If TTMusicTrack = "" Then Exit Sub
    On Error Resume Next
    PlayMusic "ThreatTide\" & TTMusicTrack, TTVolume("music")
    On Error GoTo 0
End Sub

' ----------------------------------------------------------------------------
' tt_display.vbs
' ----------------------------------------------------------------------------
' =============================================================================
' Threat Tide - FlexDMD display
'
' Screens: game (score, info, next target, 7 chain pips), callout overlay,
' board report, initials entry, claim (QR), attract, setup error.
' Every figure goes through TTMoney: no raw points anywhere.
' If FlexDMD is not installed the table still runs, without a display.
' =============================================================================

' FlexDMD alignment values
Const TTD_TOPLEFT = 0
Const TTD_TOP = 1
Const TTD_LEFT = 3
Const TTD_CENTER = 4
Const TTD_BOTTOM = 7

Dim FlexDMD, TTD_Ok
Dim TTD_ColOrange, TTD_ColPink, TTD_ColWhite, TTD_ColGrey, TTD_ColBg
Dim TTD_FBigO, TTD_FBigW, TTD_FMedO, TTD_FMedW, TTD_FSmallO, TTD_FSmallW, TTD_FSmallP, TTD_FTinyW, TTD_FTinyO, TTD_FTinyG

' Screens (groups)
Dim TTD_Game, TTD_Call, TTD_Report, TTD_Initials, TTD_Claim, TTD_Attract, TTD_Error

' Game screen
Dim TTD_lblScore, TTD_lblInfo, TTD_lblNext
Dim TTD_Pips(6)
Dim TTD_LastScoreText, TTD_LastInfoText, TTD_LastNextText

' Callout overlay + queue
Dim TTD_lblCall1, TTD_lblCall2
Dim TTD_CallActive, TTD_CallUntil, TTD_CallIsCard
Dim TTD_Q1(15), TTD_Q2(15), TTD_QMs(15), TTD_QHead, TTD_QCount
Dim TTD_PendCard1, TTD_PendCard2, TTD_PendCardAt, TTD_HasPendCard

' Report
Dim TTD_rTitle, TTD_rTotal, TTD_rWorst, TTD_rPath, TTD_rAssets, TTD_rClose1, TTD_rClose2

' Initials
Dim TTD_iTitle, TTD_iLetters, TTD_iHelp

' Claim
Dim TTD_cQr, TTD_cTitle, TTD_cLine1, TTD_cLine2, TTD_cLine3

' Attract
Dim TTD_aBig, TTD_aMed, TTD_aS(4)

' Error
Dim TTD_eLines(5)

' ---------------------------------------------------------------- setup

Sub TTDisplayInit()
    Dim i, x
    TTD_Ok = False
    TTD_CallActive = False
    TTD_QHead = 0
    TTD_QCount = 0
    TTD_HasPendCard = False
    TTD_LastScoreText = ""
    TTD_LastInfoText = ""
    TTD_LastNextText = ""

    On Error Resume Next
    Set FlexDMD = CreateObject("FlexDMD.FlexDMD")
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        Exit Sub
    End If
    On Error GoTo 0

    TTD_ColOrange = RGB(255, 136, 24)
    TTD_ColPink = RGB(255, 154, 163)
    TTD_ColWhite = RGB(255, 255, 255)
    TTD_ColGrey = RGB(110, 110, 110)
    TTD_ColBg = RGB(26, 27, 28)

    With FlexDMD
        .GameName = "ThreatTide"
        .TableFile = Table1.Filename & ".vpx"
        .RenderMode = 2   ' full colour
        .Width = TT_DMD_W
        .Height = TT_DMD_H
        .Clear = True
    End With

    Set TTD_FBigO = FlexDMD.NewFont(TT_FONT_BIG, TTD_ColOrange, TTD_ColBg, 0)
    Set TTD_FBigW = FlexDMD.NewFont(TT_FONT_BIG, TTD_ColWhite, TTD_ColBg, 0)
    Set TTD_FMedO = FlexDMD.NewFont(TT_FONT_MED, TTD_ColOrange, TTD_ColBg, 0)
    Set TTD_FMedW = FlexDMD.NewFont(TT_FONT_MED, TTD_ColWhite, TTD_ColBg, 0)
    Set TTD_FSmallO = FlexDMD.NewFont(TT_FONT_SMALL, TTD_ColOrange, TTD_ColBg, 0)
    Set TTD_FSmallW = FlexDMD.NewFont(TT_FONT_SMALL, TTD_ColWhite, TTD_ColBg, 0)
    Set TTD_FSmallP = FlexDMD.NewFont(TT_FONT_SMALL, TTD_ColPink, TTD_ColBg, 0)
    Set TTD_FTinyW = FlexDMD.NewFont(TT_FONT_TINY, TTD_ColWhite, TTD_ColBg, 0)
    Set TTD_FTinyO = FlexDMD.NewFont(TT_FONT_TINY, TTD_ColOrange, TTD_ColBg, 0)
    Set TTD_FTinyG = FlexDMD.NewFont(TT_FONT_TINY, TTD_ColGrey, TTD_ColBg, 0)

    FlexDMD.LockRenderThread

    ' Game
    Set TTD_Game = TTDGroup("game")
    Set TTD_lblScore = TTDLabel(TTD_Game, "score", TTD_FBigW, "$0", TT_DMD_W / 2, 3, TTD_TOP)
    Set TTD_lblInfo = TTDLabel(TTD_Game, "info", TTD_FSmallW, "", TT_DMD_W / 2, 32, TTD_TOP)
    Set TTD_lblNext = TTDLabel(TTD_Game, "next", TTD_FSmallO, "", TT_DMD_W / 2, 42, TTD_TOP)
    For i = 0 To 6
        x = 16 + i * 32
        Set TTD_Pips(i) = FlexDMD.NewFrame("pip" & i)
        TTD_Pips(i).Thickness = 1
        TTD_Pips(i).BorderColor = TTD_ColGrey
        TTD_Pips(i).FillColor = TTD_ColOrange
        TTD_Pips(i).Fill = False
        TTD_Pips(i).SetBounds x, 55, 28, 6
        TTD_Game.AddActor TTD_Pips(i)
    Next

    ' Callout overlay (sits above the game screen)
    Set TTD_Call = TTDGroup("call")
    Set TTD_lblCall1 = TTDLabel(TTD_Call, "call1", TTD_FMedO, "", TT_DMD_W / 2, 14, TTD_TOP)
    Set TTD_lblCall2 = TTDLabel(TTD_Call, "call2", TTD_FSmallW, "", TT_DMD_W / 2, 36, TTD_TOP)

    ' Board report
    Set TTD_Report = TTDGroup("report")
    Set TTD_rTitle = TTDLabel(TTD_Report, "rtitle", TTD_FTinyG, "BOARD REPORT", TT_DMD_W / 2, 1, TTD_TOP)
    Set TTD_rTotal = TTDLabel(TTD_Report, "rtotal", TTD_FMedO, "", TT_DMD_W / 2, 8, TTD_TOP)
    Set TTD_rWorst = TTDLabel(TTD_Report, "rworst", TTD_FSmallW, "", TT_DMD_W / 2, 22, TTD_TOP)
    Set TTD_rPath = TTDLabel(TTD_Report, "rpath", TTD_FTinyO, "", TT_DMD_W / 2, 31, TTD_TOP)
    Set TTD_rAssets = TTDLabel(TTD_Report, "rassets", TTD_FSmallP, "", TT_DMD_W / 2, 38, TTD_TOP)
    Set TTD_rClose1 = TTDLabel(TTD_Report, "rclose1", TTD_FTinyW, "WANT THIS NUMBER FOR YOUR REAL ENVIRONMENT?", TT_DMD_W / 2, 50, TTD_TOP)
    Set TTD_rClose2 = TTDLabel(TTD_Report, "rclose2", TTD_FTinyO, "ASK US AT THE BOOTH.", TT_DMD_W / 2, 57, TTD_TOP)

    ' Initials
    Set TTD_Initials = TTDGroup("initials")
    Set TTD_iTitle = TTDLabel(TTD_Initials, "ititle", TTD_FSmallO, "ENTER YOUR INITIALS", TT_DMD_W / 2, 2, TTD_TOP)
    Set TTD_iLetters = TTDLabel(TTD_Initials, "iletters", TTD_FBigW, "A__", TT_DMD_W / 2, 14, TTD_TOP)
    Set TTD_iHelp = TTDLabel(TTD_Initials, "ihelp", TTD_FTinyG, "FLIPPERS CHANGE LETTER - START TO ENTER", TT_DMD_W / 2, 56, TTD_TOP)

    ' Claim (QR)
    Set TTD_Claim = TTDGroup("claim")
    On Error Resume Next
    Set TTD_cQr = FlexDMD.NewImage("qr", TT_QR_IMAGE)
    If Err.Number = 0 Then
        TTD_cQr.SetBounds 4, 4, 56, 56
        TTD_Claim.AddActor TTD_cQr
    End If
    Err.Clear
    On Error GoTo 0
    Set TTD_cTitle = TTDLabel(TTD_Claim, "ctitle", TTD_FMedO, "SCAN TO ENTER", 66, 4, TTD_TOPLEFT)
    Set TTD_cLine1 = TTDLabel(TTD_Claim, "cline1", TTD_FSmallW, "", 66, 22, TTD_TOPLEFT)
    Set TTD_cLine2 = TTDLabel(TTD_Claim, "cline2", TTD_FSmallW, TT_FormUrl, 66, 34, TTD_TOPLEFT)
    Set TTD_cLine3 = TTDLabel(TTD_Claim, "cline3", TTD_FTinyG, "OR ASK US AT THE BOOTH TABLET", 66, 48, TTD_TOPLEFT)

    ' Attract
    Set TTD_Attract = TTDGroup("attract")
    Set TTD_aBig = TTDLabel(TTD_Attract, "abig", TTD_FBigO, "", TT_DMD_W / 2, 4, TTD_TOP)
    Set TTD_aMed = TTDLabel(TTD_Attract, "amed", TTD_FMedW, "", TT_DMD_W / 2, 32, TTD_TOP)
    For i = 0 To 4
        Set TTD_aS(i) = TTDLabel(TTD_Attract, "as" & i, TTD_FTinyW, "", TT_DMD_W / 2, 6 + i * 11, TTD_TOP)
    Next

    ' Setup error
    Set TTD_Error = TTDGroup("error")
    For i = 0 To 5
        Set TTD_eLines(i) = TTDLabel(TTD_Error, "e" & i, TTD_FTinyW, "", 2, 2 + i * 10, TTD_TOPLEFT)
    Next

    TTDShowOnly ""
    FlexDMD.UnlockRenderThread
    FlexDMD.Run = True
    TTD_Ok = True
End Sub

Sub TTDisplayExit()
    If Not TTD_Ok Then Exit Sub
    On Error Resume Next
    FlexDMD.Run = False
    On Error GoTo 0
End Sub

Function TTDGroup(name)
    Dim g, bg
    Set g = FlexDMD.NewGroup(name)
    Set bg = FlexDMD.NewFrame(name & "_bg")
    bg.Thickness = 0
    bg.Fill = True
    bg.FillColor = TTD_ColBg
    bg.SetBounds 0, 0, TT_DMD_W, TT_DMD_H
    g.AddActor bg
    g.Visible = False
    FlexDMD.Stage.AddActor g
    Set TTDGroup = g
End Function

Function TTDLabel(group, name, font, text, x, y, align)
    Dim l
    Set l = FlexDMD.NewLabel(name, font, text)
    l.SetAlignedPosition x, y, align
    group.AddActor l
    Set TTDLabel = l
End Function

' Set label text and re-anchor (FlexDMD aligns once, at the current size)
Sub TTDSet(lbl, text, x, y, align)
    lbl.Text = text
    lbl.SetAlignedPosition x, y, align
End Sub

Sub TTDSetC(lbl, text, y)
    TTDSet lbl, text, TT_DMD_W / 2, y, TTD_TOP
End Sub

' Show one screen ("game", "report", ...). Callout overlay is managed separately.
Sub TTDShowOnly(name)
    TTD_Game.Visible = (name = "game")
    TTD_Report.Visible = (name = "report")
    TTD_Initials.Visible = (name = "initials")
    TTD_Claim.Visible = (name = "claim")
    TTD_Attract.Visible = (name = "attract")
    TTD_Error.Visible = (name = "error")
    If name <> "game" Then
        TTD_Call.Visible = False
        TTD_CallActive = False
        TTD_QCount = 0
        TTD_HasPendCard = False
    End If
End Sub

Sub TTDisplayShow(name)
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread
    TTDShowOnly name
    FlexDMD.UnlockRenderThread
End Sub

' ---------------------------------------------------------------- game screen

Sub TTDisplayStartGame()
    If Not TTD_Ok Then Exit Sub
    TTD_LastScoreText = ""
    TTD_LastInfoText = ""
    TTD_LastNextText = ""
    TTDisplayShow "game"
End Sub

' Called every tick while a game is running.
Sub TTDisplayUpdate(g, nowMs)
    Dim s, info, nxt, i, nextLit, blinkOn
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread

    s = TTMoney(g.Score)
    If s <> TTD_LastScoreText Then
        TTDSetC TTD_lblScore, s, 3
        TTD_LastScoreText = s
    End If

    If g.SurgeActive Then
        info = "STORM SURGE " & g.SurgeSecondsLeft(nowMs) & "S  WEATHER X" & g.SurgeMult & "  PEAK X" & g.SurgePeak
    ElseIf g.MultiballActive Then
        info = "CONSENSUS JACKPOT " & TTMoney(g.Jackpot) & "  EXPERTS " & g.BallsInPlay
    Else
        info = "BALL " & g.BallNum & "  PATH X" & g.PathMult & "  IMPACT " & TTMoney(g.Impact)
        If g.BallSaveActive(nowMs) Then info = info & "  IR"
    End If
    If info <> TTD_LastInfoText Then
        TTDSetC TTD_lblInfo, info, 32
        TTD_LastInfoText = info
    End If

    nextLit = g.NextLitStage()
    If g.Tilted Then
        nxt = "INCIDENT DECLARED"
    ElseIf g.SurgeActive Then
        nxt = "CENTRE RAMP: TAIL JACKPOT " & TTMoney(g.SurgeSum * g.SurgePeak)
    ElseIf g.AirGapOpen Then
        nxt = "AIR GAP OPEN: " & TTMoney(g.Jackpot * TT_AIRGAP_MULT)
    ElseIf nextLit < TT_STAGE_COUNT Then
        nxt = "NEXT: " & UCase(TT_StageNames(nextLit))
        If g.LocksLit > 0 And Not g.MultiballActive Then nxt = nxt & " - LOCK LIT"
    Else
        nxt = ""
    End If
    If nxt <> TTD_LastNextText Then
        TTDSetC TTD_lblNext, nxt, 42
        TTD_LastNextText = nxt
    End If

    blinkOn = ((Int(nowMs / 250) Mod 2) = 0)
    For i = 0 To 6
        If g.StageDone(i) Then
            TTD_Pips(i).Fill = True
            TTD_Pips(i).BorderColor = TTD_ColOrange
        ElseIf i = nextLit And blinkOn Then
            TTD_Pips(i).Fill = False
            TTD_Pips(i).BorderColor = TTD_ColOrange
        Else
            TTD_Pips(i).Fill = False
            TTD_Pips(i).BorderColor = TTD_ColGrey
        End If
    Next

    TTDCalloutTick nowMs
    FlexDMD.UnlockRenderThread
End Sub

' ---------------------------------------------------------------- callouts

' Card callouts replace each other; other messages queue so none are lost.
Sub TTDisplayCard(line1, line2, nowMs)
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread
    If Not TTD_CallActive Or TTD_CallIsCard Then
        TTDShowCallout line1, line2, TT_CARD_SHOW_MS, nowMs, True
    Else
        TTD_PendCard1 = line1
        TTD_PendCard2 = line2
        TTD_PendCardAt = nowMs
        TTD_HasPendCard = True
    End If
    FlexDMD.UnlockRenderThread
End Sub

Sub TTDisplayMessage(line1, line2, ms, nowMs)
    Dim slot
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread
    If Not TTD_CallActive Or TTD_CallIsCard Then
        TTDShowCallout line1, line2, ms, nowMs, False
    ElseIf TTD_QCount < 16 Then
        slot = (TTD_QHead + TTD_QCount) Mod 16
        TTD_Q1(slot) = line1
        TTD_Q2(slot) = line2
        TTD_QMs(slot) = ms
        TTD_QCount = TTD_QCount + 1
    End If
    FlexDMD.UnlockRenderThread
End Sub

Sub TTDShowCallout(line1, line2, ms, nowMs, isCard)
    TTDSetC TTD_lblCall1, line1, 14
    TTDSetC TTD_lblCall2, line2, 36
    TTD_Call.Visible = True
    TTD_CallActive = True
    TTD_CallIsCard = isCard
    TTD_CallUntil = nowMs + ms
End Sub

Sub TTDCalloutTick(nowMs)
    If Not TTD_CallActive Then Exit Sub
    If nowMs < TTD_CallUntil Then Exit Sub
    If TTD_QCount > 0 Then
        TTDShowCallout TTD_Q1(TTD_QHead), TTD_Q2(TTD_QHead), TTD_QMs(TTD_QHead), nowMs, False
        TTD_QHead = (TTD_QHead + 1) Mod 16
        TTD_QCount = TTD_QCount - 1
    ElseIf TTD_HasPendCard And nowMs - TTD_PendCardAt < TT_CARD_SHOW_MS Then
        TTD_HasPendCard = False
        TTDShowCallout TTD_PendCard1, TTD_PendCard2, TT_CARD_SHOW_MS, nowMs, True
    Else
        TTD_HasPendCard = False
        TTD_Call.Visible = False
        TTD_CallActive = False
    End If
End Sub

' ---------------------------------------------------------------- board report

Sub TTDisplayReport(g)
    Dim i, ids, worst, assets
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread
    TTDSetC TTD_rTotal, "REALISED LOSS " & TTMoneyFull(g.Score), 8

    If g.WorstPathValue > 0 Then
        worst = "YOUR WORST DAY " & TTMoney(g.WorstPathValue)
        ids = ""
        For i = 0 To TT_STAGE_COUNT - 1
            If i > 0 Then ids = ids & ">"
            ids = ids & TTCardId(g.WorstPathCard(i))
        Next
    Else
        worst = "NO ATTACK PATH COMPLETED"
        ids = "HIT THE LIT SHOT. BUILD THE CHAIN."
    End If
    TTDSetC TTD_rWorst, worst, 22
    TTDSetC TTD_rPath, ids, 31

    assets = "ASSETS COMPROMISED: " & g.AssetsDropped
    If g.AirGapBreached Then assets = assets & "   AIR GAP BREACHED"
    TTDSetC TTD_rAssets, assets, 38

    TTDShowOnly "report"
    FlexDMD.UnlockRenderThread
End Sub

' ---------------------------------------------------------------- initials / claim

Sub TTDisplayInitials(letters)
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread
    TTDSetC TTD_iLetters, letters, 14
    TTDShowOnly "initials"
    FlexDMD.UnlockRenderThread
End Sub

Sub TTDisplayClaim(initials, score)
    If Not TTD_Ok Then Exit Sub
    FlexDMD.LockRenderThread
    TTDSet TTD_cLine1, initials & "  " & TTMoneyFull(score), 66, 22, TTD_TOPLEFT
    TTDShowOnly "claim"
